<?xml version="1.0" encoding="UTF-8"?>
<extentreports>
    <configuration>
        <theme>dark</theme>
        <enableTimeline>true</enableTimeline>
        <encoding>UTF-8</encoding>
        <protocol>https</protocol>

        <documentTitle>Test Automation Report</documentTitle>
        <reportName>UI Regression Results - October Suite</reportName>
        <timestampFormat>dd-MM-yyyy HH:mm:ss</timestampFormat>

        <styles>
            <![CDATA[
                .brand-logo {
                    font-size: 24px !important;
                    color: #00e676 !important;
                }
                nav .nav-wrapper {
                    background-color: #1e1e1e !important;
                }
            ]]>
        </styles>

        <scripts>
            <![CDATA[
                $(document).ready(function() {
                    // Auto-expand failed tests only
                    $('.test.passed').hide();
                });
            ]]>
        </scripts>
    </configuration>
</extentreports>